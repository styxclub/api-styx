{
  "name": "styxclub/api-styx",
  "description": "API para la aplicación web Styx",
  "type": "project",
  "homepage": "https://styx.osumi.es",
  "require": {
    "php": ">=8.5",
    "osumionline/framework": "^9.12.1",
    "osumionline/plugin-image": "^3.3.0",
    "osumionline/plugin-token": "^3.0.0"
  },
  "autoload": {
    "psr-4": {
      "Osumi\\OsumiFramework\\App\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "osumionline/plugin-updater": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
